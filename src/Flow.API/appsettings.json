{
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017/?replicaSet=rs0",
    "Database": "flow",
    "EnsureIndexes": true
  },
  "JwtSettings": {
    "SecretKey": "CHANGE-THIS-IN-PRODUCTION-must-be-at-least-32-chars",
    "Issuer": "FlowAPI",
    "Audience": "FlowApp",
    "ExpiryMinutes": "15"
  },
  "Auth": {
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
