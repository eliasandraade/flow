# Flow — environment configuration
#
# Copy to .env and fill in. Never commit the filled file: .env is gitignored.
# Every value below is a placeholder. None of them is a real credential.
#
# ---------------------------------------------------------------------------
# WHO READS THIS FILE
# ---------------------------------------------------------------------------
# Docker Compose, and only Docker Compose. The flat names below exist because a
# .env file is a flat format; docker-compose.yml translates each one into the
# hierarchical name the application actually binds, for example:
#
#     JWT_SECRET_KEY   ->  JwtSettings__SecretKey
#     MONGO_DATABASE   ->  Mongo__Database
#     GEMINI_API_KEY   ->  Gemini__ApiKey
#
# Running the API any other way — `dotnet run`, a PaaS that injects environment
# variables straight into the container, an orchestrator — does NOT go through
# that translation. There, use one of:
#
#     appsettings.json / appsettings.Development.json   (never for secrets)
#     dotnet user-secrets                                (local development)
#     hierarchical environment variables with "__"       (containers, CI, PaaS)
#
# The full mapping between the two spellings is in the README, under Variáveis.
#
# Three names are flat in both worlds, because the application reads them flat:
# CORS_ALLOWED_ORIGINS, SEED_DEMO_DATA and SEED_DEMO_PASSWORD.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Must point at a replica set. Multi-document transactions do not exist on a
# standalone server, and the audit guarantees depend on them.
MONGO_DATABASE=flow

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# At least 32 bytes. The API refuses to start outside Development with a short
# secret or with the placeholder value still in place.
# Generate one with:  openssl rand -base64 48
JWT_SECRET_KEY=
JWT_ISSUER=FlowAPI
JWT_AUDIENCE=FlowApp
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ---------------------------------------------------------------------------
# Gemini — the copilot and the executive insights
# ---------------------------------------------------------------------------
# Optional. Without it the intelligent endpoints answer 503 and everything else
# works normally. Server-side only: this key must never reach the mobile app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------------
# OneSignal — push delivery
# ---------------------------------------------------------------------------
# Optional. Without it the in-app notification centre still works; outbox
# messages stay pending rather than being marked as delivered.
# The REST API key is a server secret. Only the app id goes to the client.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Optional OTLP collector. Absent, instrumentation stays active in-process and
# the API starts normally — a missing collector never takes the service down.
OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# API surface
# ---------------------------------------------------------------------------
SWAGGER_ENABLED=true

# Comma-separated origins. Leave empty in production only if no browser client
# calls the API; a wildcard is never used.
# CORS_ALLOWED_ORIGINS=https://flow.example.com

# ---------------------------------------------------------------------------
# Demonstration data
# ---------------------------------------------------------------------------
# Seeds a full narrative dataset: strategy, campaigns, ideas in every state,
# projects running, blocked and delivered, results, notifications and history.
# Idempotent. Never enable in production.
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# Mobile (mobile/.env or EAS build profile)
# ---------------------------------------------------------------------------
# EXPO_PUBLIC_ENV=local | development | production
# EXPO_PUBLIC_API_URL=https://flow-api.example.com
# EXPO_PUBLIC_ONESIGNAL_APP_ID=
